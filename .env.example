# Copy to .env.local for local testing, and add the same values in
# Vercel → Project → Settings → Environment Variables for production.
# Never commit real values.

# Resend (https://resend.com → API Keys). Sends the contact-form email.
RESEND_API_KEY=
# Where messages are delivered.
CONTACT_TO_EMAIL=justinkesslerio@protonmail.com
# Optional. Until you verify a domain in Resend, leave this unset: the default
# onboarding@resend.dev sender can only deliver to your Resend account's email.
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile → Add widget).
# The site key is public and ends up in the page; the secret key stays on the server.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional, recommended: Upstash Redis so rate limits hold across every
# serverless instance (Vercel → Storage → Upstash, or https://upstash.com).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Comma-separated origins allowed to post the form, e.g.
# https://justin.dev,https://www.justin.dev. Default: the site's own host.
ALLOWED_ORIGINS=

# Set to 1 to log messages instead of sending them.
CONTACT_DRY_RUN=
